<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:f="sap.f"
    xmlns:cards="sap.f.cards">

    <m:ScrollContainer
        horizontal="true"
        vertical="false"
        width="100%"
        height="9.5rem"
        class="sapUiSmallMarginTop sapUiSmallMarginBottom">

        <m:HBox renderType="Bare" class="sapUiSmallMarginBegin">

            <!-- Total Transactions -->
            <f:Card width="14rem" height="9rem" class="sapUiTinyMarginEnd">
                <f:header>
                    <cards:NumericHeader
                        title="Total Invoices"
                        titleMaxLines="1"
                        subtitle="Period 09/2026"
                        number="{kpi>/totalTransactions}"
                        unit="" />
                </f:header>
            </f:Card>

            <!-- Touchless Posted -->
            <f:Card width="14rem" height="9rem" class="sapUiTinyMarginEnd">
                <f:header>
                    <cards:NumericHeader
                        title="Touchless Posted"
                        titleMaxLines="1"
                        subtitle="71.4% • 4.2 pts vs. July"
                        number="{kpi>/touchlessCount}"
                        unit=""
                        state="Good"
                        trend="Up">
                        <cards:sideIndicators>
                            <cards:NumericSideIndicator
                                title="Rate"
                                number="{kpi>/touchlessRate}"
                                unit="%" />
                        </cards:sideIndicators>
                    </cards:NumericHeader>
                </f:header>
            </f:Card>

            <!-- Exceptions -->
            <f:Card width="14rem" height="9rem" class="sapUiTinyMarginEnd">
                <f:header>
                    <cards:NumericHeader
                        title="Exceptions"
                        titleMaxLines="1"
                        subtitle="4 aged over SLA"
                        number="{kpi>/exceptions}"
                        unit=""
                        state="{kpi>/exceptionState}" />
                </f:header>
            </f:Card>

            <!-- Awaiting Approval -->
            <f:Card width="14rem" height="9rem" class="sapUiTinyMarginEnd">
                <f:header>
                    <cards:NumericHeader
                        title="Awaiting Approval"
                        titleMaxLines="1"
                        subtitle="2 at Level 2 • 3 at Level 1"
                        number="{kpi>/awaitingApproval}"
                        unit=""
                        state="Critical" />
                </f:header>
            </f:Card>

        </m:HBox>
    </m:ScrollContainer>

</core:FragmentDefinition>