<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <HBox renderType="Bare" alignItems="Center">
        <ObjectStatus
            text="{Status}"
            icon="{= ${Status} === 'Posted' ? 'sap-icon://accept' : (${Status} === 'Validation Failed' || ${Status} === 'Posting Failed' || ${Status} === 'Blocked' ? 'sap-icon://decline' : (${Status} === 'Awaiting Coding' || ${Status} === 'Awaiting Approval' ? 'sap-icon://pending' : 'sap-icon://hint')) }"
            state="{= ${Status} === 'Posted' ? 'Success' : (${Status} === 'Validation Failed' || ${Status} === 'Posting Failed' || ${Status} === 'Blocked' ? 'Error' : (${Status} === 'Awaiting Coding' || ${Status} === 'Awaiting Approval' ? 'Warning' : 'Information')) }"
            emptyIndicatorMode="Off" />
    </HBox>

</core:FragmentDefinition>