{
  "_version": "1.89.0",

  "sap.app": {
    "id": "demotransactions",
    "type": "application",
    "i18n": "i18n/i18n.properties",

    "applicationVersion": {
      "version": "0.0.1"
    },

    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",

    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.32.0",
      "toolsId": "36ea2840-3d42-49e3-a03b-01a60724d522"
    },

    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },

      "mainService": {
        "uri": "/here/goes/your/serviceurl/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },

  "sap.ui": {
    "technology": "UI5",

    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },

    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },

  "sap.ui5": {
    "flexEnabled": true,

    "dependencies": {
      "minUI5Version": "1.152.0",

      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },

    "contentDensities": {
      "compact": true,
      "cozy": true
    },

    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "demotransactions.i18n.i18n"
        }
      },

      "": {
        "dataSource": "mainService",
        "preload": true,

        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },

      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },

    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "demotransactions.ext.controller.ListReportExt"
          }
        }
      }
    },

    "resources": {
      "css": []
    },

    "routing": {
      "config": {},

      "routes": [
        {
          "pattern": ":?query:",
          "name": "TransactionsList",
          "target": "TransactionsList"
        },

        {
          "pattern": "Transactions({key}):?query:",
          "name": "TransactionsObjectPage",
          "target": "TransactionsObjectPage"
        }
      ],

      "targets": {
        "TransactionsList": {
          "type": "Component",
          "id": "TransactionsList",
          "name": "sap.fe.templates.ListReport",

          "options": {
            "settings": {
              "contextPath": "/Transactions",

              "variantManagement": "Page",

              "content": {
                "header": {
                  "customHeader": {
                    "expandedHeaderFragment": "demotransactions.ext.fragment.KPICards"
                  }
                }
              },

              "navigation": {
                "Transactions": {
                  "detail": {
                    "route": "TransactionsObjectPage"
                  }
                }
              },

            "controlConfiguration": {
  "@com.sap.vocabularies.UI.v1.LineItem": {
    "columns": {
      "StatusColumn": {
        "header": "Status",
        "position": { "placement": "After", "anchor": "Amount" },
        "template": "demotransactions.ext.fragment.StatusColumn"
      },
      "ProgressColumn": {
        "header": "Progress",
        "position": { "placement": "After", "anchor": "StatusColumn" },
        "template": "demotransactions.ext.fragment.ProgressColumn"
      }
    }
  }
}
            }
          }
        },

        "TransactionsObjectPage": {
          "type": "Component",
          "id": "TransactionsObjectPage",
          "name": "sap.fe.templates.ObjectPage",

          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Transactions"
            }
          }
        }
      }
    }
  },

  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },

  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}